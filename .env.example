# SentinelForge runtime configuration
# Development defaults are intentionally non-production.

SENTINELFORGE_ENV=development
SECRET_KEY=replace-with-at-least-32-random-characters
FERNET_KEY=
DB_URL=postgresql+asyncpg://sentinelforge:sentinelforge@localhost:5432/sentinelforge
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:8000
TOKEN_EXPIRE_MINUTES=1440
BOOTSTRAP_ADMIN_TOKEN=generate-a-long-one-time-bootstrap-secret
INGEST_API_KEY=generate-a-long-machine-ingest-secret

# Optional runtime integrations
SENTINELFORGE_USE_MOCKS=1
SENTINELFORGE_ENABLE_SOCKET=0
SENTINELFORGE_MAX_EVENTS=200
SENTINELFORGE_API_TIMEOUT=5
SENTINELFORGE_VERIFY_TLS=1

# Production requirements:
# SENTINELFORGE_ENV=production
# SECRET_KEY=<strong persistent secret>
# FERNET_KEY=<persistent Fernet key>
# CORS_ORIGINS=https://your-console.example
