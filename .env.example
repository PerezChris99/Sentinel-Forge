# SentinelForge environment variables (copy to .env and adjust values)
SECRET_KEY=changeme-super-secret
DB_URL=postgresql+psycopg2://sentinelforge:sentinelforge@localhost:5432/sentinelforge
REDIS_URL=redis://localhost:6379/0
ALFIE_WEBHOOK_URL=https://your-alfie.com/api/receive
CCTV_STREAMS=["rtsp://camera-01/stream", "rtsp://camera-02/stream"]
DASHBOARD_API_URL=http://localhost:8000
DASHBOARD_SOCKET_URL=ws://localhost:8000
JWT_AUDIENCE=sentinelforge-dashboard
JWT_ISSUER=sentinelforge-auth
SENTINELFORGE_USE_MOCKS=1
SENTINELFORGE_ENABLE_SOCKET=0
SENTINELFORGE_MAX_EVENTS=200
SENTINELFORGE_API_TIMEOUT=5
SENTINELFORGE_VERIFY_TLS=1
